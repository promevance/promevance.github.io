      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1v4bg2m0489f1u1358rr7102t02g].[max:artist_followers:qk]&quot;' value='Spotify Followers' />
          <alias key='&quot;[federated.1v4bg2m0489f1u1358rr7102t02g].[usr:Calculation_39468955160711173:qk]&quot;' value='Hit Rate' />
          <alias key='&quot;[federated.1v4bg2m0489f1u1358rr7102t02g].[usr:Calculation_39468955160883206:qk]&quot;' value='Explicit Tracks' />
          <alias key='&quot;[federated.1v4bg2m0489f1u1358rr7102t02g].[usr:Calculation_39468955161137160:qk]&quot;' value='Avg Track Length' />
        </aliases>
      </column>
      <column datatype='string' name='[Artist Tier]' role='dimension' type='nominal' />
      <column caption='Release Period' datatype='string' name='[Calculation_0468178391973888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Release Year] &lt;= 2015 THEN &quot;2010–15&quot;&#13;&#10;ELSEIF [Release Year] &lt;= 2020 THEN &quot;2016–20&quot;&#13;&#10;ELSE &quot;2021–25&quot; END' />
        <aliases>
          <alias key='&quot;2010–15&quot;' value='2010–15 487 Hits' />
          <alias key='&quot;2016–20&quot;' value='2016–20 624 Hits' />
          <alias key='&quot;2021–25&quot;' value='2021–25 774 Hits' />
        </aliases>
      </column>
      <column caption='Hit Source' datatype='string' name='[Calculation_0468178392100865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Genre Family] = &quot;Latin&quot; OR [Genre Family] = &quot;K-pop&quot; THEN &quot;Latin &amp; K-pop&quot;&#13;&#10;ELSEIF [Artist Tier] = &quot;Superstar (10M+)&quot; THEN &quot;Other superstars&quot;&#13;&#10;ELSE &quot;All other artists&quot; END' />
      </column>
      <column caption='Tracks' datatype='integer' name='[Calculation_39468955159011328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([track_id])' />
      </column>
      <column caption='Artists' datatype='integer' name='[Calculation_39468955159433217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([artist_name])' />
      </column>
      <column caption='Albums' datatype='integer' name='[Calculation_39468955159670786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([album_id])' />
      </column>
      <column caption='Avg Popularity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_39468955160174595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([track_popularity])' />
      </column>
      <column caption='Hit Tracks' datatype='boolean' name='[Calculation_39468955160522756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[track_popularity] &gt;= 70' />
      </column>
      <column caption='% Hits' datatype='real' default-format='p0.0%' name='[Calculation_39468955160711173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_39468955160522756],1,0)) / COUNT([track_id])' />
      </column>
      <column caption='% Explicit' datatype='real' default-format='p0.0%' name='[Calculation_39468955160883206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([explicit],1,0)) / COUNT([track_id])' />
      </column>
      <column caption='% Singles' datatype='real' default-format='p0%' name='[Calculation_39468955161010183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([album_type]=&quot;single&quot;,1,0)) / COUNT([track_id])' />
      </column>
      <column caption='Avg Duration' datatype='real' datatype-customized='true' default-format='n#,##0.0&quot; min&quot;;-#,##0.0&quot; min&quot;' name='[Calculation_39468955161137160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([track_duration_min])' />
      </column>
      <column caption='Share of Tracks' datatype='real' default-format='p0%' name='[Calculation_39468955161366537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([track_id]) / TOTAL(COUNT([track_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share of Artists' datatype='real' default-format='p0%' name='[Calculation_39468955161571338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([artist_name]) / TOTAL(COUNTD([artist_name]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Popularity vs Average' datatype='real' name='[Calculation_39468955162112011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([track_popularity]) - MIN({FIXED : AVG([track_popularity])})' />
      </column>
      <column caption='Length Band' datatype='string' datatype-customized='true' name='[Calculation_40264176972525568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [track_duration_min] &lt; 2 THEN &quot;&lt;2&quot;&#13;&#10;ELSEIF [track_duration_min] &lt; 2.5 THEN &quot;2–2.5&quot;&#13;&#10;ELSEIF [track_duration_min] &lt; 3 THEN &quot;2.5–3&quot;&#13;&#10;ELSEIF [track_duration_min] &lt; 3.5 THEN &quot;3–3.5&quot;&#13;&#10;ELSEIF [track_duration_min] &lt; 4 THEN &quot;3.5–4&quot;&#13;&#10;ELSEIF [track_duration_min] &lt; 5 THEN &quot;4–5&quot;&#13;&#10;ELSE &quot;5+&quot; END' />
      </column>
      <column caption='Opportunity' datatype='boolean' name='[Calculation_40264177013047300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Genre Family] = &quot;Latin&quot; OR [Genre Family] = &quot;K-pop&quot;' />
      </column>
