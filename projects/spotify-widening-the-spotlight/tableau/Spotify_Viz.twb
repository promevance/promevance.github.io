    <worksheet name='Artist Tiers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>8% of artists supply 42% of tracks and retain the highest scores</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Tracks' name='federated.1v4bg2m0489f1u1358rr7102t02g' />
          </datasources>
          <datasource-dependencies datasource='federated.1v4bg2m0489f1u1358rr7102t02g'>
            <column datatype='string' name='[Artist Tier]' role='dimension' type='nominal' />
            <column caption='Avg Popularity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_39468955160174595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([track_popularity])' />
            </column>
            <column caption='Share of Tracks' datatype='real' default-format='p0%' name='[Calculation_39468955161366537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([track_id]) / TOTAL(COUNT([track_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Share of Artists' datatype='real' default-format='p0%' name='[Calculation_39468955161571338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([artist_name]) / TOTAL(COUNTD([artist_name]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Genre Family]' role='dimension' type='nominal' />
            <column caption='Artist Name' datatype='string' name='[artist_name]' role='dimension' type='nominal' />
            <column-instance column='[Artist Tier]' derivation='None' name='[none:Artist Tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[Genre Family]' derivation='None' name='[none:Genre Family:nk]' pivot='key' type='nominal' />
            <column caption='Track Id' datatype='string' name='[track_id]' role='dimension' type='nominal' />
