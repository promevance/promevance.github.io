                </zone>
                <zone h='7500' id='9' type-v2='dashboard-object' w='11552' x='87114' y='2000'>
                  <button action='tabdoc:goto-sheet window-id=&quot;{E29F0AD2-2CD0-4277-95E2-B08575054655}&quot;' button-type='text'>
                    <button-visual-state>
                      <caption>Opportunities</caption>
                      <button-caption-font-style fontcolor='#1b1b1b' fontname='Arial' fontsize='8' />
                      <format attr='background-color' value='#1db954' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='1' />
                      <format attr='border-color' value='#333333' />
                    </button-visual-state>
                  </button>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7250' id='36' type-v2='text' w='96000' x='667' y='10500'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='11'>Roadmap of Opportunities</run>
                    <run fontcolor='#000000' fontsize='11'>: how Spotify could make the most of its fastest-growing listener tastes</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2812' id='54' type-v2='text' w='32888' x='667' y='21750'>
                  <formatted-text>
                    <run fontcolor='#1db954' fontsize='7'>YEARS 1–3 · 2026–2028</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2812' id='55' type-v2='text' w='32890' x='33555' y='21750'>
                  <formatted-text>
                    <run fontcolor='#1db954' fontsize='7'>YEARS 3–5 · 2029–2031</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2812' id='56' type-v2='text' w='32888' x='66445' y='21750'>
                  <formatted-text>
                    <run fontcolor='#1db954' fontsize='7'>YEARS 5–10 · 2032–2035</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='43125' id='63' type-v2='text' w='32888' x='667' y='27375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='15'>Test and Learn</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Recommend Latin &amp; K-pop to listeners with nearby tastes (pop, hip-hop, R&amp;B) through A/B tests</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Deepen editorial playlists and home-screen shelves for both genres</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Release-day features with labels and agencies</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='43125' id='64' type-v2='text' w='32890' x='33555' y='27375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='15'>Grow the Pipeline</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Bring emerging Latin &amp; K-pop artists into Spotify artist programmes to fast-track their growth</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Give their teams audience data and marketing tools</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Sponsor fan experiences around tours and big releases for Latin and K-pop artistes</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='43125' id='65' type-v2='text' w='32888' x='66445' y='27375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='15'>Repeat the Playbook</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Review the genre matrix every quarter for the next rising tastes</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Apply the same test-and-grow approach to them</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>• Keep superstars central while the spotlight widens</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='15500' id='60' type-v2='text' w='32888' x='667' y='70500'>
                  <formatted-text>
                    <run fontsize='8'>Evidence: Latin &amp; K-pop rose from 0.6% to 14% of new hits, with hit rates of 54% and 46% against 28% overall.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='15500' id='61' type-v2='text' w='32834' x='33583' y='70500'>
                  <formatted-text>
                    <run fontsize='8'>Evidence: emerging artists have a 1% hit rate, and one artist (Bad Bunny) alone accounts for 55% of Latin hits.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='15500' id='62' type-v2='text' w='32916' x='66417' y='70500'>
                  <formatted-text>
                    <run fontsize='8'>Evidence: the superstar share of new hits fell from 69% (2016–20) to 56% (2021–25); tastes keep widening.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4500' id='57' type-v2='text' w='32888' x='667' y='86000'>
                  <formatted-text>
                    <run fontsize='7'>KPI to watch: Latin &amp; K-pop share of new hits, 14% → 20%</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#eaf8ef' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4500' id='58' type-v2='text' w='32890' x='33555' y='86000'>
                  <formatted-text>
                    <run fontsize='7'>KPI to watch: emerging-artist hit rate 1% → 5%; no artist above 30% of a genre&apos;s hits</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#eaf8ef' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4500' id='59' type-v2='text' w='32888' x='66445' y='86000'>
                  <formatted-text>
                    <run fontsize='7'>KPI to watch: overall hit rate 28% → 35%; non-superstar share of hits above 40%</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#eaf8ef' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4000' id='14' type-v2='text' w='98666' x='667' y='95000'>
                  <formatted-text>
                    <run fontalignment='1' italic='true'>Source: Spotify Dataset supplied for the course, prepared in Tableau Prep Builder</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
