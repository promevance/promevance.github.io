            </zone>
          </zone>
          <zone h='2813' id='45' param='horz' type-v2='layout-flow' w='32890' x='33555' y='24562' />
          <zone h='43125' id='47' param='horz' type-v2='layout-flow' w='32890' x='33555' y='27375'>
            <zone forceUpdate='true' h='43125' id='64' type-v2='text' w='32890' x='33555' y='27375'>
              <formatted-text>
                <run bold='true' fontcolor='#333333' fontsize='15'>Grow the Pipeline</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333'>• Bring emerging Latin &amp; K-pop artists into Spotify artist programmes to fast-track their growth</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333'>• Give their teams audience data and marketing tools</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333'>• Sponsor fan experiences around tours and big releases for Latin and K-pop artistes</run>
                <run>Æ&#10;&#10;&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
