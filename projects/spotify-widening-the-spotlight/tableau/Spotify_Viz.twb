    <worksheet name='Who Gets the Hits'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Latin and K-pop went from under 1% to 14% of new hits</run>
            <run>Æ&#10;</run>
            <run fontcolor='#818b91' fontsize='8'>Share of hit tracks (popularity &gt;= 70) by release period. Superstars = 10m+ followers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Tracks' name='federated.1v4bg2m0489f1u1358rr7102t02g' />
          </datasources>
          <datasource-dependencies datasource='federated.1v4bg2m0489f1u1358rr7102t02g'>
            <column datatype='string' name='[Artist Tier]' role='dimension' type='nominal' />
            <column caption='Release Period' datatype='string' name='[Calculation_0468178391973888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Release Year] &lt;= 2015 THEN &quot;2010–15&quot;&#13;&#10;ELSEIF [Release Year] &lt;= 2020 THEN &quot;2016–20&quot;&#13;&#10;ELSE &quot;2021–25&quot; END' />
              <aliases>
                <alias key='&quot;2010–15&quot;' value='2010–15 487 Hits' />
                <alias key='&quot;2016–20&quot;' value='2016–20 624 Hits' />
                <alias key='&quot;2021–25&quot;' value='2021–25 774 Hits' />
              </aliases>
            </column>
            <column caption='Hit Source' datatype='string' name='[Calculation_0468178392100865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Genre Family] = &quot;Latin&quot; OR [Genre Family] = &quot;K-pop&quot; THEN &quot;Latin &amp; K-pop&quot;&#13;&#10;ELSEIF [Artist Tier] = &quot;Superstar (10M+)&quot; THEN &quot;Other superstars&quot;&#13;&#10;ELSE &quot;All other artists&quot; END' />
            </column>
            <column caption='Hit Tracks' datatype='boolean' name='[Calculation_39468955160522756]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[track_popularity] &gt;= 70' />
            </column>
            <column datatype='string' name='[Genre Family]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Release Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0468178391973888]' derivation='None' name='[none:Calculation_0468178391973888:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0468178392100865]' derivation='None' name='[none:Calculation_0468178392100865:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39468955160522756]' derivation='None' name='[none:Calculation_39468955160522756:nk]' pivot='key' type='nominal' />
            <column-instance column='[Genre Family]' derivation='None' name='[none:Genre Family:nk]' pivot='key' type='nominal' />
            <column-instance column='[Release Year]' derivation='None' name='[none:Release Year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[track_id]' derivation='Count' name='[pcto:cnt:track_id:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1v4bg2m0489f1u1358rr7102t02g].[none:Calculation_0468178392100865:nk]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Track Id' datatype='string' name='[track_id]' role='dimension' type='nominal' />
            <column caption='Track Popularity' datatype='integer' name='[track_popularity]' role='measure' type='quantitative' />
          </datasource-dependencies>
